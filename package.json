{
  "name": "cricket07-mac",
  "productName": "Cricket 07 for Mac",
  "version": "1.7.2",
  "description": "Mac app for Dhaiwat's browser port of EA Sports Cricket 07: offline play, full screen, real player names, save backups",
  "license": "MIT",
  "repository": "github:udeshvirk/cricket07-desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 -c.productName=\"Cricket 07 for Windows\" -c.extraMetadata.productName=\"Cricket 07 for Windows\" --publish never"
  },
  "build": {
    "appId": "com.github.udeshvirk.cricket07mac",
    "productName": "Cricket 07 for Mac",
    "files": [
      "main.js",
      "saves.js",
      "screenshot.js",
      "names.js",
      "real-names.json",
      "squads.js",
      "squads-2026.json",
      "enhance.js",
      "settings.html",
      "settings-preload.js",
      "updates.js",
      "diagnostics.js"
    ],
    "directories": {
      "buildResources": "build-res",
      "output": "dist"
    },
    "artifactName": "Cricket07-Mac-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.sports-games",
      "icon": "build-res/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build-res/icon.png",
      "artifactName": "Cricket07-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cricket 07"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
